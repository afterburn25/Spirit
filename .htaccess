DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|includes|config|storage|database|docs|tests|tools|views|design|vendor|\.git|\.github)(?:/|$) - [F,L]
</IfModule>
<FilesMatch "(?i)^(?:\..*|composer\.(?:json|lock)|VERSION|AGENTS\.md|README\.md|CHANGELOG\.md|PROJECT_STATUS\.md|SESSION_HANDOFF\.md)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
